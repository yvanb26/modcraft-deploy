# Cle partagee que le launcher doit presenter pour obtenir un token (POST /api/auth/token)
# Changez-la avant toute distribution publique du launcher.
LAUNCHER_KEY=change-moi-en-production

# Secret utilise pour signer les JWT delivres aux launchers
JWT_SECRET=change-moi-aussi

# Duree de validite du token (format vercel/ms : "1h", "15m", ...)
TOKEN_TTL=1h

PORT=8787

# Nombre de reverse proxys (nginx...) devant l'API. Laissez vide si les launchers se connectent directement.
# Sans cela, derriere un proxy, les limites par IP s'appliqueraient a tous les joueurs a la fois.
# TRUST_PROXY=1

# Origines web autorisees a appeler l'API depuis un navigateur (CORS), separees par des virgules.
# Laissez vide : le launcher et l'admin n'en ont pas besoin, et ca empeche un site tiers de lire l'API.
# CORS_ORIGINS=

# Serveurs en ligne : le launcher prouve que le compte Microsoft lui appartient avant d'inscrire le pseudo a la whitelist.
# Interrupteur de secours : OWNERSHIP_CHECK=off desactive cette verification.
# OWNERSHIP_CHECK=on
